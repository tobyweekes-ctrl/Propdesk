# Copy to .env and fill in. Never commit .env. Keys are only read server-side.

# Stats source (real NBA data unless demo):
#   espn        ESPN public box scores, no key, works anywhere (default)
#   nba         stats.nba.com (what nba_api uses), no key, often blocked from cloud servers
#   balldontlie needs BALLDONTLIE_API_KEY (ALL-STAR tier)
#   demo        fictional offline league for development only
STATS_PROVIDER=espn
# balldontlie key (needs the ALL-STAR tier or above for /stats and /player_injuries)
BALLDONTLIE_API_KEY=
# requests per minute your balldontlie tier allows (free 5, ALL-STAR 60, GOAT 600)
BALLDONTLIE_RPM=60

# The Odds API (https://the-odds-api.com) for player prop lines
ODDS_API_KEY=
# bookmaker regions to request: us, us2, uk, eu, au (each region multiplies quota cost)
ODDS_REGIONS=us
# which props to fetch, as stat keys (each costs 1 credit per region per game); empty = all 8
# e.g. ODDS_MARKETS=pts,reb,ast,pra
ODDS_MARKETS=
# minutes to cache prop odds (quota saver)
ODDS_TTL_MIN=10
# also fetch the game spread (+1 market per props call) to sharpen blowout risk; off by default
ODDS_FETCH_SPREADS=false

# Injury source: espn | demo
INJURY_PROVIDER=espn

PORT=5177
